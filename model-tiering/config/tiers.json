    "risky": ["架构", "设计", "排查", "迁移", "重构", "优化", "安全", "并发", "性能", "兼容"],
    "codeExt": ["js", "ts", "mjs", "cjs", "tsx", "jsx", "py", "ps1", "json", "yml", "yaml", "html", "css", "vue", "go", "rs", "java"],
