  "levels": {
    "low": {
      "label": "轻",
      "rank": "first",
      "delegate": "none",
      "signal": "单步、事实问答、格式转换、单文件小改、闲聊"
    },
    "mid": {
      "label": "中",
      "rank": "middle",
      "delegate": "allowed",
      "signal": "2–5 步、读 1–2 个文件、结果可校验"
    },
    "high": {
      "label": "高",
      "rank": "last",
      "delegate": "preferred",
      "signal": "多文件改动、架构/排错、不可逆操作、跨系统"
    }
  },
  "models": {
